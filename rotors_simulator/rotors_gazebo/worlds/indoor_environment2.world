<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="indoor_environment">
    <plugin name='ros_interface_plugin' filename='librotors_gazebo_ros_interface_plugin.so'/>
    <physics type='ode'>
      <gravity>0 0 -9.8</gravity>
      <max_step_size>0.001</max_step_size>
      <max_contacts>20</max_contacts> <!-- 最大碰撞检测点数 -->
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- 增加更大的地面 -->
    <model name="floor">
      <static>true</static> <!-- 地面是静态物体 -->
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>50 50 0.1</size> <!-- 地面大小：50x50米，厚度0.1米 -->
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient> <!-- 灰色地面 -->
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =============================== -->
    <!-- Random small box obstacles (20) -->
    <!-- Map boundary: x,y in [-25, 25]  -->
    <!-- =============================== -->

    <model name="obstacle_01">
      <static>true</static>
      <pose>-18  -18  0.75  0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.8 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 1.5</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_02">
      <static>true</static>
      <pose>-10  -20  0.60  0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 1.2</size></box></geometry>
        </visual>
      </link>
    </model>

